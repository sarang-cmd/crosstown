{
  "name": "crosstown",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.*",
    "test:browser": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "package": "node tools/package-project.mjs",
    "assets:prepare": "node tools/prepare-asset.mjs",
    "assets:fixtures": "node tools/prepare-fixtures.mjs",
    "assets:check": "node tools/check-assets.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "test:parkour": "playwright test --config playwright.parkour.config.ts",
    "test:deployed": "playwright test --config playwright.deployed.config.ts",
    "simulate:parkour": "tsx tools/simulate-parkour.ts --all-runs",
    "verify:deployed": "node tools/verify-deployed.mjs",
    "assets:runner": "node tools/prepare-parkour-character.mjs",
    "test:city": "playwright test --config playwright.city.config.ts",
    "profile": "node tools/profile-browser.mjs --current-only",
    "test:vehicles": "playwright test --config playwright.vehicles.config.ts",
    "assets:audio": "python3 tools/prepare-car-audio.py",
    "test:fleet": "playwright test --config playwright.fleet.config.ts",
    "accept:roster": "tsx tools/accept-roster.ts",
    "accept:traffic": "tsx tools/accept-traffic.ts",
    "accept:population": "node tools/accept-population.mjs",
    "assets:roster": "node tools/prepare-roster.mjs",
    "assets:roster-audio": "python3 tools/prepare-roster-audio.py",
    "credits": "node --input-type=module -e \"import {writeCredits} from './tools/credits.mjs';await writeCredits(process.cwd());\"",
    "accept:landing": "node tools/accept-landing.mjs",
    "accept:life": "node tools/accept-city-life.mjs",
    "accept:activities": "node tools/accept-activities.mjs",
    "accept:radio": "node tools/accept-radio-providers.mjs",
    "accept:lighting": "node tools/accept-lighting.mjs",
    "profile:lighting": "node tools/profile-lighting.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/three": "0.180.0",
    "draco3dgltf": "1.5.7",
    "fflate": "0.8.2",
    "meshoptimizer": "0.24.0",
    "sharp": "0.34.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  },
  "description": "A coastal browser city with rooftop parkour, twelve Rapier vehicles, stylized police pursuits, six activities and in-car radio. Lightweight landing; Three.js WebGPU + WebGL 2.",
  "keywords": [
    "threejs",
    "webgpu",
    "webgl2",
    "typescript",
    "rapier",
    "parkour",
    "open-world",
    "procedural-generation",
    "vite",
    "browser-game"
  ]
}
